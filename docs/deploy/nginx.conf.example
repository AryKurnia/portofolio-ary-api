# Contoh Nginx untuk API portofolio di homelab. Salin ke /etc/nginx/conf.d/portfolio.conf,
# ganti domain dan path sertifikat TLS, lalu `sudo nginx -t && sudo systemctl reload nginx`.
#
# - API      : https://api.example.com      → container API (127.0.0.1:3000, docker-compose.yml)
# - Storage  : https://storage.example.com  → MinIO (127.0.0.1:9000), nilai MINIO_PUBLIC_URL
#   Storage SENGAJA di subdomain terpisah: PDF sertifikat dibuka inline di origin yang berbeda
#   dari web/API, jadi isi PDF tidak bisa membaca cookie atau memanggil API atas nama admin.

# ---------- blok http {} (file di conf.d/ sudah berada di dalam http {}) ----------
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=5r/15m;
limit_req_zone $binary_remote_addr zone=admin_upload:10m rate=30r/h;

upstream portfolio_api {
    server 127.0.0.1:3000;
    keepalive 16;
}

# HTTP → HTTPS
server {
    listen 80;
    server_name api.example.com storage.example.com;
    return 301 https://$host$request_uri;
}

# ---------- API ----------
server {
    listen 443 ssl;
    http2 on;
    server_name api.example.com;

    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;

    # Batas upload terbesar di API: 5 MB (sertifikat) + 64 KB overhead multipart.
    client_max_body_size 6m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Rate limit login: 5 percobaan / 15 menit / IP.
    location = /api/v1/admin/auth/login {
        limit_req zone=admin_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://portfolio_api;
    }

    # Rate limit upload: 30 / jam / IP.
    location = /api/v1/admin/uploads {
        limit_req zone=admin_upload burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://portfolio_api;
    }

    location /api/ {
        proxy_pass http://portfolio_api;
    }

    location / {
        return 404;
    }
}

# ---------- Storage (MinIO, hanya baca publik) ----------
server {
    listen 443 ssl;
    http2 on;
    server_name storage.example.com;

    ssl_certificate     /etc/letsencrypt/live/storage.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/storage.example.com/privkey.pem;

    # Publik hanya membaca file; upload/hapus dilakukan API lewat jaringan Docker, bukan lewat sini.
    location / {
        limit_except GET HEAD {
            deny all;
        }
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:9000;
        add_header X-Content-Type-Options nosniff always;
    }
}
