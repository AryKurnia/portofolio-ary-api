# Salin ke .env lalu isi nilainya. Jangan commit .env.

# Server
NODE_ENV=development
SERVER_HOST=localhost
SERVER_PORT=3000
# Origin yang boleh memanggil API dari browser, dipisah koma. Kosong = CORS mati.
CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent (default: info, saat tes: silent)
LOG_LEVEL=info

# Database (MariaDB)
DATABASE_HOST=localhost
DATABASE_USER=portfolio_app
DATABASE_PASSWORD=ganti-dengan-password-db
DATABASE_NAME=portfolio
DATABASE_TEST_NAME=portfolio_test

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ganti-dengan-access-key
MINIO_SECRET_KEY=ganti-dengan-secret-key
MINIO_BUCKET=portfolio
MINIO_PUBLIC_URL=http://localhost:9000

# JWT (production: minimal 32 karakter, mis. `openssl rand -base64 48`)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN_SECONDS=3600

# Seeder admin (hanya dipakai `npx sequelize-cli db:seed:all`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-admin
